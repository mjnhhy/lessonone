        /* Hoa hồng nhạt rơi nhẹ nhàng */
        .petal {
            position: fixed;
            top: -40px;
            opacity: 0.6;
            pointer-events: none;
            z-index: 1;
            animation: fallDown linear infinite;
        }
        @keyframes fallDown {
            0% { transform: translateY(0) rotate(0deg) translateX(0); opacity: 0; }
            15% { opacity: 0.65; }
            85% { opacity: 0.65; }
            100% { transform: translateY(105vh) rotate(360deg) translateX(25px); opacity: 0; }
        }

